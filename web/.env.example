# Optional. Without a key the assistant uses the local deterministic composer.
# Claude is used when set; otherwise DeepSeek (below) when set.
ANTHROPIC_API_KEY=
# Optional model override (default in src/domain/assistant/anthropic.ts).
ANTHROPIC_MODEL=
# Optional DeepSeek provider (OpenAI-compatible). Used only when ANTHROPIC_API_KEY is empty.
DEEPSEEK_API_KEY=
# Optional model override (default in src/domain/assistant/deepseek.ts).
DEEPSEEK_MODEL=
# Optional accounts (Supabase). Without these the app stays guest-only on this device.
# Use the project URL and the *publishable* key; both reach the browser, and row-level security
# (supabase/migrations) protects each account's data. Never put the sb_secret_ key in the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
